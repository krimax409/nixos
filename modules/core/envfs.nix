{
  # FUSE-файловая система, которая отдаёт /bin/* и /usr/bin/* как симлинки на
  # исполняемые файлы из PATH запрашивающего процесса.
  #
  # Нужна для софта вне Nix store, который хардкодит пути в шебангах. Прямой
  # повод: Hermes Desktop при самообновлении генерирует скрипт перезапуска с
  # `#!/bin/bash` и вызывает его через spawn. На NixOS в /bin есть только sh,
  # поэтому Electron умирал на необработанном `spawn /bin/bash ENOENT` сразу
  # после того, как обновление уже применилось, — то есть каждое обновление
  # гарантированно закрывало приложение.
  #
  # /bin/sh и /usr/bin/env остаются настоящими симлинками NixOS: envfs
  # подхватывает их из stage-2, а не подменяет.
  services.envfs.enable = true;
}
